model DirectMessage {
  id          Int      @id @default(autoincrement())
  senderId    Int?
  recipientId Int?
  body        String
  createdAt   DateTime @default(now())

  sender      User?    @relation("DmSent", fields: [senderId], references: [id], onDelete: SetNull)
  recipient   User?    @relation("DmReceived", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId, id])
}


model DmRead {
  userId     Int
  otherUserId Int
  lastReadAt DateTime @default(now())

  user      User @relation("DmReadUser", fields: [userId], references: [id], onDelete: Cascade)
  otherUser User @relation("DmReadOtherUser", fields: [otherUserId], references: [id], onDelete: Cascade)

  @@id([userId, otherUserId])
}