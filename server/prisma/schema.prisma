// Core models (Aritra). Teammates add their own files in prisma/models/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(20)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  messages     Message[]

  @@map("users")
}

// The token is the primary key: random, so it can't be guessed. Logout deletes the row; no expiry.
model Session {
  token     String   @id @default(uuid()) @db.Uuid
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model Room {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(30)
  createdAt DateTime  @default(now()) @map("created_at")
  messages  Message[]

  @@map("rooms")
}

// userId is nullable: deleting a user keeps their messages as "deleted user" (SET NULL).
model Message {
  id        Int      @id @default(autoincrement())
  roomId    Int      @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("messages")
}
