// Core models (Aritra). Teammates add their own files in prisma/models/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  messages     Message[]
  dmSent       DirectMessage[] @relation("DmSent")
  dmReceived   DirectMessage[] @relation("DmReceived")
  dmReads      DmRead[] @relation("DmReadUser")
  dmReadsOfOther DmRead[] @relation("DmReadOtherUser")
}

// The token is the primary key: random, so it can't be guessed. Logout deletes the row; no expiry.
model Session {
  token     String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Room {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  messages  Message[]
}

// userId is nullable: deleting a user keeps their messages as "deleted user" (SET NULL).
model Message {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  // Speeds up "latest 20 messages in room X" (graded DE task, see learning notes).
  @@index([roomId, createdAt])
}
